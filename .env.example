# ===== Base de données =====
POSTGRES_PASSWORD=change_me
# Même mot de passe que ci-dessus ; l'hôte "postgres" est le service docker-compose
DATABASE_URL=postgresql+asyncpg://orchestrator_user:change_me@postgres:5432/orchestrator

# ===== Sécurité =====
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_key
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ===== Ollama (natif macOS, joint depuis Docker via host.docker.internal) =====
# Modèle rapide pour les tâches courtes (requêtes de veille, scoring, briefing).
# Les modèles pour le code, l'idéation et l'analyse se choisissent dans Paramètres.
OLLAMA_MODEL_PROMPT=gemma4:12b-mlx

# ===== Sources externes (optionnelles) =====
# Aides publiques FR avec deadlines structurées — clé gratuite : https://aides-territoires.beta.gouv.fr/api/
AIDES_TERRITOIRES_API_KEY=
# Remplace DuckDuckGo pour la recherche web (plus fiable, 2000 req/mois gratuites)
# SearXNG — métamoteur auto-hébergé (service `searxng` du docker-compose).
# Backend de recherche prioritaire : ni clé, ni quota. Laisser vide pour
# retomber sur Brave puis DuckDuckGo.
SEARXNG_URL=http://searxng:8080
# Clé de signature de l'instance : python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Brave Search — repli (l'offre gratuite n'existe plus)
BRAVE_SEARCH_API_KEY=

# Unsplash et Pexels — moodboard : photographies sous licence permissive
# (usage libre, y compris commercial). Clés gratuites en quelques clics :
#   https://unsplash.com/developers   →  Access Key
#   https://www.pexels.com/api/       →  API Key
# Vides = sources simplement ignorées.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Are.na — moodboard : collections curatées d'art/design contemporain.
# Jeton perso gratuit sur https://dev.are.na/oauth/applications (vide = source ignorée).
# Attention : les images Are.na sont des RÉFÉRENCES, pas des visuels libres de droits.
ARENA_ACCESS_TOKEN=

# ===== Notifications du briefing sur le téléphone (optionnel) =====
# Installe l'app ntfy (iOS/Android), abonne-toi à un topic difficile à deviner, mets-le ici.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# URL publique de l'app (ex. https://mon-mac.tailnet.ts.net) pour le lien dans la notification
APP_PUBLIC_URL=
